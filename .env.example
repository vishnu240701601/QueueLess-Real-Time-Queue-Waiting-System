# ==========================================
# QueueLess - Unified Environment Variables Template
# Copy relevant keys to client/.env and server/.env
# ==========================================

# ------------------------------------------
# FRONTEND CONFIGURATION (client/.env)
# ------------------------------------------
# Supabase Project URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key (safe for browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Backend API Base URL
# For local development: http://localhost:5000/api
# For production (Vercel): https://your-queueless-api.vercel.app/api
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------
# BACKEND CONFIGURATION (server/.env or Vercel Environment Variables)
# ------------------------------------------
PORT=5000
NODE_ENV=development

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (NEVER expose to frontend; used only in serverless backend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (from Supabase Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Frontend origin allowed for CORS (e.g. Netlify URL or local Vite)
CLIENT_ORIGIN=http://localhost:5173
