# ==========================================
# QueueLess Backend Environment Variables (server/.env)
# ==========================================

# Server Port (for local standalone testing only)
PORT=5000
NODE_ENV=development

# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (NEVER expose to browser/client)
# (from Supabase Dashboard -> Project Settings -> API -> Project API keys -> service_role)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5173,https://your-app.netlify.app
